# /etc/ris-backup/backup.env  (mode 0600, owner = the backup user)
# Copy from backup.env.example. Nothing here is committed with real values.

# ---- Where things live on the host
BACKUP_ROOT=/var/backups/ris
STATE_DIR=/var/lib/ris-backup
LOG_FILE=/var/log/ris/backup.log
LOCAL_RETENTION_DAYS=3                 # 20 GB disk: keep this small
APP_ENV_FILE=/home/ubuntu/Registrar-Information-System/.env

# ---- Database (use a dedicated read-only user; see README step 3).
# If these are left blank the scripts fall back to DB_* in APP_ENV_FILE.
BACKUP_DB_HOST=
BACKUP_DB_PORT=3306
BACKUP_DB_NAME=registrar_information_system
BACKUP_DB_USER=ris_backup
BACKUP_DB_PASSWORD=
DB_SSL_MODE=REQUIRED

# ---- Encryption. Prefer GPG_RECIPIENT (public key only on this host).
GNUPGHOME=/etc/ris-backup/gnupg
GPG_RECIPIENT=ris-backup@pup-taguig.example   # key id or email of the backup public key
#GPG_PASSPHRASE_FILE=/etc/ris-backup/passphrase   # fallback only: symmetric AES-256

# ---- Offsite vault (separate bucket with Object Lock) and media source
S3_BUCKET=ris-backup-vault-CHANGE-ME
S3_PREFIX=ris
AWS_REGION=ap-southeast-1
MEDIA_BUCKET=ris-file-storage
# Dedicated backup IAM user, NOT ris-s3-user and NOT ris-ci-deploy:
AWS_SHARED_CREDENTIALS_FILE=/etc/ris-backup/aws-credentials
AWS_PROFILE=ris-backup

# ---- Optional second-provider copy (Hostinger KVM VPS). Leave HOSTINGER_HOST blank to disable.
HOSTINGER_HOST=
HOSTINGER_USER=ris-backup
HOSTINGER_DIR=/srv/ris-backups
HOSTINGER_SSH_KEY=/etc/ris-backup/hostinger_ed25519
HOSTINGER_PORT=22

# ---- Alerts (Discord/Slack/Teams incoming webhook). Optional but strongly advised.
ALERT_WEBHOOK_URL=
