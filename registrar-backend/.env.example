# Security Events (Phase 3 — failed logins, IDP-unreachable fallback)
SECURITY_EVENTS_RETENTION_DAYS=90
SECURITY_EVENTS_ALERT_THRESHOLD=5
SECURITY_EVENTS_ALERT_WINDOW_MINUTES=10

FEATURE_FREE_REQUEST_PAGE=true

# Undergrad Requestor Registration — retention windows (Phase 4 / D9).
# Both defaults reuse windows this codebase already established:
#   14 = the existing pending_expires_at invite window
#   90 = SECURITY_EVENTS_RETENTION_DAYS
# Commented out because the config defaults are already correct; set
# them explicitly only if the Registrar's retention policy diverges.
# UNDERGRAD_REQUESTOR_ABANDONMENT_DAYS=14
# UNDERGRAD_REQUESTOR_REJECTED_RETENTION_DAYS=90
# UNDERGRAD_REQUESTOR_PURGE_CHUNK_SIZE=200
# UNDERGRAD_REQUESTOR_OGOS_CACHE_TTL=120

# Undergrad Requestor Registration — security & privacy (Phase 6).
#
# PII encryption at rest for the four display-only self-declared columns
# on undergrad_requestor_profiles (date_of_birth, present_address,
# reason_for_non_enrollment, phone). Leave this ON.
#
#   !! These values are recoverable ONLY with APP_KEY. Rotating APP_KEY
#   !! without re-encrypting first makes them permanently unreadable.
#   !! Treat APP_KEY as a backed-up production secret, not a per-deploy
#   !! value. See App\Support\EncryptedPayload.
#
# UNDERGRAD_REQUESTOR_ENCRYPT_PII=true

# Data Privacy Act (RA 10173) consent notice.
# Bump the version string whenever the notice WORDING changes in a way
# that alters what a requestor is agreeing to — every submission stores
# the version it was shown, so historical consents keep pointing at the
# text actually displayed. Never re-use a version for different text.
# The notice itself defaults to a working placeholder in
# config/undergrad_requestor.php; it needs Data Protection Officer
# sign-off before go-live, and can be overridden here or there.
# UNDERGRAD_REQUESTOR_CONSENT_VERSION=1.0
# UNDERGRAD_REQUESTOR_PRIVACY_NOTICE_URL=
# UNDERGRAD_REQUESTOR_PRIVACY_NOTICE=

# Public onboarding endpoint rate limits (per-IP and per-email buckets).
# Defaults are tuned for a university, not a consumer signup page: a
# computer lab where a whole class registers from one NAT address must
# not lock itself out. If a limit bites in production, RAISE the per-IP
# figures — do not relax the per-email one, which is the bucket that
# protects someone who is not even using the system from having their
# inbox used as a target.
# UNDERGRAD_REQUESTOR_REGISTER_IP_PER_MIN=5
# UNDERGRAD_REQUESTOR_REGISTER_IP_PER_DAY=60
# UNDERGRAD_REQUESTOR_REGISTER_EMAIL_PER_DAY=5
# UNDERGRAD_REQUESTOR_CONFIRM_IP_PER_MIN=10
# UNDERGRAD_REQUESTOR_CONFIRM_EMAIL_PER_HOUR=20
# UNDERGRAD_REQUESTOR_NOTICE_IP_PER_MIN=30
# UNDERGRAD_REQUESTOR_THROTTLE_EVENT_DEDUPE_MINUTES=10