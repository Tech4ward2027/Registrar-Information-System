<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- Phase 6 (Undergrad Requestor PII encryption — App\Support\EncryptedPayload,
             App\Casts\EncryptedText/EncryptedDate) made Crypt::encryptString()/
             decryptString() reachable from a plain, un-mocked feature test for
             the first time in this codebase (SystemUser's 'idp_access_token'
             => 'encrypted' cast existed earlier, but no test path exercised it
             through the same everyday flow this feature's registration
             endpoint does). Laravel's encrypter throws
             MissingAppKeyException the moment it's resolved with no APP_KEY —
             which every one of those tests now is, on every run.
             Previously the suite only ever worked by accident: whatever the
             CI workflow's `php artisan key:generate` step happened to leave
             in .env at that moment, IF that step ran, IF it ran before the
             test step, and IF nothing since had cleared it. A `php artisan
             test` run on a fresh checkout, before ever running key:generate
             — the exact situation a new contributor or a fresh CI cache
             hits — had no APP_KEY at all and every encryption-touching test
             failed with the same "No application encryption key has been
             specified" error, regardless of anything correct or incorrect in
             the test itself.
             Forced here for the same reason CASHIER_API_KEY and
             FEATURE_FREE_REQUEST_PAGE already are below: the test suite
             must be able to run standalone, deterministically, without
             depending on an external, order-sensitive setup step or a real
             secret leaking in from a host .env. This value is committed
             on purpose — it is a fixed, throwaway test key with no
             relationship to any real deployment's APP_KEY, exists only to
             satisfy "a key is present," and encrypts/decrypts nothing that
             outlives a single test's in-memory SQLite database. -->
        <env name="APP_KEY" value="base64:YHz6kBBVB4bX6H9q+2z1Yp1BdxQ0KnO78Ny3lIvLsU8=" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="log"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Without this, docker-compose.local.yml's env_file: .env on the
             backend service leaks the real local CASHIER_API_KEY into
             `php artisan test` runs (Laravel's env() prefers an
             already-set OS env var over any .env.testing value, and this
             tag list is the only thing phpunit.xml actually forces). That
             silently flips CashierService into live mode for any test
             that doesn't reset it by hand — see RisFeatureTest.php and
             the SEED_LOCAL_DEV_ACCOUNTS comment in DatabaseSeeder.php for
             the same class of bug. Forcing it here closes it for every
             test, present and future, instead of relying on each test to
             remember `config(['services.cashier.api_key' => ''])`. -->
        <env name="CASHIER_API_KEY" value="" force="true"/>
        <!-- config/features.php intentionally defaults every flag to
             `false` (fail closed) so a forgotten .env line in production
             never silently switches a gated feature on. Tests exist to
             exercise the code, not to be blocked by that same production
             safety net, so the suite runs with it forced on by default —
             one line, one place, instead of every FreeRequest test file
             remembering `config(['features.free_request_page' => true])`
             in its own beforeEach(). A test that specifically needs to
             verify the disabled/404 behavior overrides this locally with
             config(['features.free_request_page' => false]) for that one
             test — that's the correct scope for an exception, not the
             suite-wide default. force="true" matches the CASHIER_API_KEY
             entry above: without it, docker-compose.local.yml's env_file
             can leak a real FEATURE_FREE_REQUEST_PAGE=false (or true)
             from the host .env into the run, same class of bug. -->
        <env name="FEATURE_FREE_REQUEST_PAGE" value="true" force="true"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>